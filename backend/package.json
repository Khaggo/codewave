{
  "name": "backend",
  "version": "1.0.0",
  "description": "AUTOCARE backend workspace",
  "private": true,
  "scripts": {
    "build:main": "tsc -p apps/main-service/tsconfig.app.json",
    "build": "npm run build:main",
    "typecheck:main": "tsc -p apps/main-service/tsconfig.app.json --noEmit --incremental false",
    "typecheck": "npm run typecheck:main",
    "start:main": "node -r ts-node/register -r tsconfig-paths/register apps/main-service/src/main.ts",
    "start:main:compiled": "node --enable-source-maps scripts/compiled-service-runtime.mjs main-service",
    "dev:main": "node -r ts-node/register/transpile-only -r tsconfig-paths/register apps/main-service/src/main.ts",
    "dev:main:managed": "npm run build:main && npm run start:main:compiled",
    "test": "jest --maxWorkers=4",
    "test:serial": "jest --runInBand",
    "test:main": "jest --maxWorkers=4 apps/main-service",
    "test:shared": "jest --maxWorkers=2 shared scripts",
    "test:coverage": "jest --coverage --coverageReporters=json-summary --runInBand",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node scripts/db-migrate.cjs",
    "db:push:local": "node -r ts-node/register scripts/db-push-local.ts",
    "contracts:generate": "node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/generate-openapi-contract.ts",
    "contracts:check": "node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/generate-openapi-contract.ts --check",
    "agents:check": "node -r ts-node/register scripts/check-agent-system.ts",
    "docs:validate": "node -r ts-node/register scripts/validate-architecture-docs.ts",
    "frontend:inspect": "node -r ts-node/register scripts/frontend-inspect.ts",
    "swagger:up": "node -r ts-node/register -r tsconfig-paths/register scripts/swagger-up.ts",
    "swagger:check": "node -r ts-node/register -r tsconfig-paths/register scripts/swagger-check.ts",
    "swagger:stop": "node -r ts-node/register -r tsconfig-paths/register scripts/swagger-stop.ts",
    "swagger:ready": "npm run swagger:up && npm run swagger:check",
    "repair:job-order-assignments": "node -r ts-node/register -r tsconfig-paths/register scripts/repair-job-order-assignments.ts",
    "cleanup:legacy-back-job-rework": "node -r ts-node/register -r tsconfig-paths/register scripts/cleanup-legacy-back-job-rework.ts",
    "smoke:job-order-qa": "node -r ts-node/register scripts/smoke-job-order-qa-release.ts",
    "smoke:notifications": "node -r ts-node/register scripts/smoke-notifications-feed.ts",
    "smoke:accessories-concurrency": "node -r dotenv/config -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/smoke-accessories-concurrency.ts dotenv_config_path=.env",
    "smoke:panelist-references": "node -r dotenv/config -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/smoke-panelist-business-references.ts dotenv_config_path=.env",
    "seed:booking-catalog": "node -r ts-node/register scripts/seed-booking-catalog.ts",
    "seed:booking-job-order-qa-accounts": "node -r ts-node/register scripts/seed-booking-job-order-qa-accounts.ts",
    "seed:insurance-demo": "node -r ts-node/register scripts/seed-insurance-demo.ts",
    "seed:super-admin": "node -r ts-node/register scripts/seed-super-admin.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.9",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "ajv@>=8.0.0 <9.0.0": "8.18.0",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.4",
    "form-data": "4.0.6",
    "handlebars": "4.7.9",
    "js-yaml@<4.0.0": "3.15.0",
    "picomatch@>=4.0.0 <5.0.0": "4.0.5",
    "qs": "6.15.3"
  }
}
